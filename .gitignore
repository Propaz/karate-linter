*.feature
!tests/fixtures/*.feature

# transient test output; tests/baseline.*.txt is the committed contract
tests/after.*.txt
tests/diagnostics.txt
tests/echo.txt
tests/loclist.txt
tests/format.txt
tests/reload.txt

# scratch space for real .feature files used while chasing a bug: outside the
# tests/fixtures glob, so they do not become part of the recorded baseline
tests/local/
